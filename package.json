{
  "name": "daemonpilot",
  "version": "0.0.0",
  "private": true,
  "description": "Go library for self-managing services with watchdog supervision and signed updates",
  "keywords": [],
  "license": "MIT",
  "author": "Alexander Svinarev <shibanet0@gmail.com> (shibanet0.com)",
  "type": "module",
  "scripts": {
    "build": "go build ./...",
    "test": "go test ./...",
    "test:coverage": "go test -coverprofile=coverage.out ./...",
    "test:e2e": "pnpm dm exec task -- e2e:docker"
  },
  "devDependencies": {
    "@shibanet0/datamitsu-config": "catalog:"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "warn",
      "version": ">=26.12.1"
    }
  }
}
